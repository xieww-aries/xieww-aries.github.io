{
  "name": "aries-web",
  "version": "2.0.0",
  "description": "this is Aries personal website",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'service/src/**/*.ts' --fix",
    "lint:ci": "eslint 'src/**/*.{js,jsx,ts,tsx}' 'service/src/**/*.ts'",
    "prettier": "prettier --write 'src/**/*.{js,jsx,ts,tsx}' 'service/src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "typecheck:service": "npm --prefix service run typecheck",
    "typecheck:all": "npm run typecheck && npm run typecheck:service",
    "dev": "webpack serve --mode development",
    "dev:web": "webpack serve --mode development",
    "predev:service": "node scripts/ensure-web-dist.mjs",
    "dev:service": "npm --prefix service run dev",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:service\"",
    "build": "webpack --mode production",
    "build:service": "npm --prefix service run build",
    "build:all": "npm run build && npm run build:service",
    "start": "npm --prefix service start",
    "setup": "npm install && npm --prefix service install",
    "verify": "npm run lint:ci && npm run typecheck:all && npm run build:all",
    "changelog": "commit-and-tag-version --skip.bump --skip.commit --skip.tag",
    "changelog:all": "commit-and-tag-version --skip.bump --skip.commit --skip.tag --first-release",
    "release": "commit-and-tag-version"
  },
  "author": "Aries",
  "license": "ISC",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@commitlint/cli": "^19.6.0",
    "@types/react": "^18.3.12",
    "@types/react-css-modules": "^4.6.6",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-react-css-modules": "^5.2.6",
    "commit-and-tag-version": "^12.5.0",
    "concurrently": "^10.0.5",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-webpack-plugin": "^4.2.0",
    "generic-names": "^2.0.1",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.4.2",
    "sass": "^1.81.0",
    "sass-loader": "^16.0.3",
    "typescript": "^5.6.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
